{
  "name": "portfolio-svg-icon-provider",
  "version": "1.0.5",
  "description": "A high-performance SVG icon provider for React portfolios, powered by SVGR.",
  "keywords": [
    "react",
    "icons",
    "svg",
    "portfolio",
    "svgr",
    "typescript"
  ],
  "author": "alxva <https://github.com/Douk1NG>",
  "license": "MIT",
  "homepage": "https://github.com/Douk1NG/portfolio-svg-icon-provider",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Douk1NG/portfolio-svg-icon-provider.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": "./dist/*.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "generate": "tsx scripts/generate-components.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "release": "npm run generate && npm run build && npm publish"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@svgr/core": "^8.1.0",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "esbuild-plugin-svgr": "^3.1.1",
    "jsdom": "^29.1.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-prettier": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0"
  }
}
