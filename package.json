{
  "name": "portfolio-svg-icon-provider",
  "version": "1.0.6",
  "description": "A high-performance SVG icon provider for React portfolios, powered by SVGR.",
  "keywords": [
    "react",
    "icons",
    "svg",
    "portfolio",
    "svgr",
    "typescript"
  ],
  "author": "alxva <https://github.com/Douk1NG>",
  "license": "MIT",
  "homepage": "https://github.com/Douk1NG/portfolio-svg-icon-provider",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Douk1NG/portfolio-svg-icon-provider.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": "./dist/*.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "generate": "tsx scripts/generate-components.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts",
    "demo:preview": "vite preview --config demo/vite.config.ts",
    "release": "npm run generate && npm run build && npm publish"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "jsdom": "^29.1.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^4.1.5"
  }
}
